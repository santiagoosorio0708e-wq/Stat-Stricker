# ============================================================
# StatStriker - Plantilla de variables de entorno
# 1) Copia este archivo como ".env"   (cp .env.example .env)
# 2) Rellena SOLO las claves del proveedor que vayas a usar.
# 3) NUNCA subas el archivo .env a GitHub (ya está en .gitignore).
# ============================================================

# --- Proveedor del LLM: gemini | openai | mock ---
# "mock" permite probar todo el flujo RAG sin API key (respuesta simulada).
LLM_PROVIDER=gemini

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Partidos y calendario (API-Football / API-Sports) ---
API_SPORTS_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Proveedor de embeddings: local | gemini | openai ---
# "local" usa all-MiniLM-L6-v2 (ONNX) incluido en ChromaDB, sin API key.
# IMPORTANTE: si cambias este valor, vuelve a ejecutar la ingesta con --reset.
EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Parámetros RAG ---
RAG_TOP_K=6
# Distancia coseno máxima (0 = idéntico, 2 = opuesto) para aceptar un fragmento
# cuando NO se detecta ningún equipo en la consulta. Ajústala según el modelo de embeddings.
RAG_MAX_DISTANCE=0.6
# Nº de turnos previos de la sesión que se envían al LLM como memoria.
HISTORY_TURNS=3
LLM_MAX_OUTPUT_TOKENS=1500
